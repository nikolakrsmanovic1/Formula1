<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_height"
    android:background="@color/surface">

    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/navHome"
        style="@style/NavItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_home"
        android:text="@string/nav_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navSchedule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navDivider" />

    <TextView
        android:id="@+id/navSchedule"
        style="@style/NavItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_calendar"
        android:text="@string/nav_schedule"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navStandings"
        app:layout_constraintStart_toEndOf="@id/navHome"
        app:layout_constraintTop_toBottomOf="@id/navDivider" />

    <TextView
        android:id="@+id/navStandings"
        style="@style/NavItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_trophy"
        android:text="@string/nav_standings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/navSchedule"
        app:layout_constraintTop_toBottomOf="@id/navDivider" />
</androidx.constraintlayout.widget.ConstraintLayout>
